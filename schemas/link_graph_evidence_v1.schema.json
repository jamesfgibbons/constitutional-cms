{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constitutionalcms.com/schemas/link-graph-evidence-v1.json",
  "title": "LinkGraphEvidenceV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "adapter", "source", "targets"],
  "properties": {
    "schema_version": {"const": "LinkGraphEvidenceV1"},
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "source": {"type": "object"},
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object"}
    }
  }
}
